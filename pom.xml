<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
    SPEC (Source of Truth):
- Module: com.festivaltap:core (version 1.0.0, pom aggregator & parent) with child modules core-ports and core-domain.
- Runtime/Java target: Requires Java 24 or higher and compiles with Java 24 release target.
- What is downloaded (inbound):
  - From https://maven.pkg.github.com/festival-tap: com.festivaltap:persistence (1.0.0) in test scope for core-domain tests.
  - From https://maven.pkg.github.com/sugarcoat-labs: transitive com.sugarcoatlabs:persistence-engines-* (1.0.0) dependencies needed during test execution.
  - From Maven Central (test scope): org.junit:junit-bom for JUnit 5 test dependencies.
- Boundary rule: com.festivaltap:persistence and com.sugarcoatlabs:* must never appear in compile or runtime scope of core modules.
- What is distributed (outbound): Publishes com.festivaltap:core (1.0.0) and its modules to https://maven.pkg.github.com/festival-tap/core.
    -->

    <groupId>com.festivaltap</groupId>
    <artifactId>core</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Festival Tap - Core</name>
    <description>Hexagon core (domain models, use cases, and ports) for the festival-tap self-service beer dispenser platform.</description>
    <url>https://github.com/festival-tap/core</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/festival-tap/core.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/festival-tap/core.git</developerConnection>
        <url>https://github.com/festival-tap/core</url>
    </scm>

    <modules>
        <module>core-ports</module>
        <module>core-domain</module>
    </modules>

    <properties>
        <maven.compiler.release>24</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <junit.version>5.11.4</junit.version>
        <persistence.version>1.0.0</persistence.version>
        <sugarcoat.persistence.version>1.0.0</sugarcoat.persistence.version>

        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.5</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal core contract -->
            <dependency>
                <groupId>com.festivaltap</groupId>
                <artifactId>core-ports</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Persistence adapter (strictly for core-domain test scope) -->
            <dependency>
                <groupId>com.festivaltap</groupId>
                <artifactId>persistence</artifactId>
                <version>${persistence.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Published sugarcoat-labs persistence engines (test scope via persistence adapter) -->
            <dependency>
                <groupId>com.sugarcoatlabs</groupId>
                <artifactId>persistence-engines-core</artifactId>
                <version>${sugarcoat.persistence.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.sugarcoatlabs</groupId>
                <artifactId>persistence-engines-dynamodb</artifactId>
                <version>${sugarcoat.persistence.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- JUnit 5 BOM -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>github-festival-tap</id>
            <name>GitHub Packages - festival-tap</name>
            <url>https://maven.pkg.github.com/festival-tap</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>github-sugarcoat-labs</id>
            <name>GitHub Packages - sugarcoat-labs</name>
            <url>https://maven.pkg.github.com/sugarcoat-labs</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-spec</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[24,)</version>
                                </requireJavaVersion>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>com.festivaltap:persistence:*:*:compile</exclude>
                                        <exclude>com.festivaltap:persistence:*:*:runtime</exclude>
                                        <exclude>com.sugarcoatlabs:*:*:*:compile</exclude>
                                        <exclude>com.sugarcoatlabs:*:*:*:runtime</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github-festival-tap</id>
            <name>GitHub Packages - festival-tap/core</name>
            <url>https://maven.pkg.github.com/festival-tap/core</url>
        </repository>
        <snapshotRepository>
            <id>github-festival-tap</id>
            <name>GitHub Packages - festival-tap/core</name>
            <url>https://maven.pkg.github.com/festival-tap/core</url>
        </snapshotRepository>
    </distributionManagement>
</project>